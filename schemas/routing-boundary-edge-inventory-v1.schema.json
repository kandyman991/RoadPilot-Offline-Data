{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.app/schemas/routing-boundary-edge-inventory-v1.schema.json",
  "title": "RoadPilot routing boundary edge inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "regionId", "graphFingerprint", "generator", "edges"],
  "properties": {
    "schema": {"const": "roadpilot.boundary-edge-inventory"},
    "version": {"const": 1},
    "regionId": {"type": "string", "minLength": 1},
    "graphFingerprint": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "coord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lng": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphId", "opposingGraphId", "sourceNodeGraphId", "endNodeGraphId", "wayId",
        "anchorCoordinate", "innerCoordinate", "headingDegrees", "forwardAccess",
        "reverseAccess", "roadClass", "use", "roadNames", "roadRefs", "allowedTravelModes"
      ],
      "properties": {
        "graphId": {"type": "integer", "minimum": 1},
        "opposingGraphId": {"type": "integer", "minimum": 1},
        "sourceNodeGraphId": {"type": "integer", "minimum": 1},
        "endNodeGraphId": {"type": "integer", "minimum": 1},
        "wayId": {"type": "integer", "minimum": 1},
        "anchorCoordinate": {"$ref": "#/$defs/coord"},
        "innerCoordinate": {"$ref": "#/$defs/coord"},
        "headingDegrees": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "forwardAccess": {"type": "integer", "minimum": 0},
        "reverseAccess": {"type": "integer", "minimum": 0},
        "roadClass": {"type": "integer", "minimum": 0},
        "use": {"type": "integer", "minimum": 0},
        "roadNames": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "roadRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "allowedTravelModes": {
          "type": "array",
          "items": {"enum": ["MOTORCYCLE", "CAR"]},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
