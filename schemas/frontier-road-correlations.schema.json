{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.example/schemas/frontier-road-correlations-v1.json",
  "title": "RoadPilot graph-bound frontier road correlations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "pairId",
    "fromRegionId",
    "toRegionId",
    "fromBoundaryFingerprint",
    "toBoundaryFingerprint",
    "fromGraph",
    "toGraph",
    "generator",
    "correlations"
  ],
  "properties": {
    "schema": {
      "const": "roadpilot.frontier-road-correlations"
    },
    "version": {
      "const": 1
    },
    "pairId": {
      "type": "string",
      "minLength": 3
    },
    "fromRegionId": {
      "type": "string",
      "minLength": 1
    },
    "toRegionId": {
      "type": "string",
      "minLength": 1
    },
    "fromBoundaryFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "toBoundaryFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fromGraph": {
      "$ref": "#/$defs/graph"
    },
    "toGraph": {
      "$ref": "#/$defs/graph"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "correlations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correlation"
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "packageVersion",
        "graphFingerprint",
        "primaryGeofabrikId"
      ],
      "properties": {
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "graphFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primaryGeofabrikId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "edgeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "wayMatch",
        "correlatedCoordinate",
        "wayId",
        "percentAlong",
        "distanceMeters",
        "graphId",
        "roadNames",
        "access",
        "roadClass",
        "use"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "wayMatch": {
          "type": "boolean"
        },
        "correlatedCoordinate": {
          "$ref": "#/$defs/coordinate"
        },
        "wayId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "percentAlong": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "distanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "headingDegrees": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "linearReference": {
          "type": [
            "string",
            "null"
          ]
        },
        "graphId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "roadNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "access": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "roadClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "use": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sideCorrelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidateCount",
        "sameWayCandidateCount",
        "candidates"
      ],
      "properties": {
        "status": {
          "enum": [
            "CORRELATED",
            "NO_CANDIDATES",
            "LOCATE_FAILED"
          ]
        },
        "error": {
          "type": "string"
        },
        "candidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "sameWayCandidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edgeCandidate"
          }
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontierRoadId",
        "wayId",
        "crossingIndex",
        "crossingKind",
        "frontierCoordinate",
        "fromGraph",
        "toGraph"
      ],
      "properties": {
        "frontierRoadId": {
          "type": "string",
          "pattern": "^fri1-[0-9a-f]{24}$"
        },
        "wayId": {
          "type": "integer",
          "minimum": 1
        },
        "crossingIndex": {
          "type": "integer",
          "minimum": 0
        },
        "crossingKind": {
          "enum": [
            "CROSSING",
            "FRONTIER_OVERLAP"
          ]
        },
        "frontierCoordinate": {
          "$ref": "#/$defs/coordinate"
        },
        "fromGraph": {
          "$ref": "#/$defs/sideCorrelation"
        },
        "toGraph": {
          "$ref": "#/$defs/sideCorrelation"
        }
      }
    }
  }
}
