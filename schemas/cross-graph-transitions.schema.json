{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.example/schemas/cross-graph-transitions-v1.json",
  "title": "RoadPilot cross-graph transition proof artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "fromRegionId",
    "toRegionId",
    "fromGraphFingerprint",
    "toGraphFingerprint",
    "generator",
    "transitions"
  ],
  "properties": {
    "schema": {"const": "roadpilot.cross-graph-transitions"},
    "version": {"const": 1},
    "fromRegionId": {"type": "string", "minLength": 1},
    "toRegionId": {"type": "string", "minLength": 1},
    "fromGraphFingerprint": {"type": "string", "minLength": 1},
    "toGraphFingerprint": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sourceFingerprint": {"type": "string", "minLength": 1}
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/transition"}
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lng": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "coordinate"],
      "properties": {
        "regionId": {"type": "string", "minLength": 1},
        "coordinate": {"$ref": "#/$defs/coordinate"},
        "roadName": {"type": "string", "minLength": 1},
        "roadRef": {"type": "string", "minLength": 1},
        "headingDegrees": {"type": "number", "minimum": 0, "exclusiveMaximum": 360}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fromAnchor",
        "toAnchor",
        "matchEvidence",
        "provenTravelModes",
        "firstLegDistanceMeters",
        "firstLegDurationSeconds",
        "secondLegDistanceMeters",
        "secondLegDurationSeconds",
        "totalDistanceMeters",
        "totalDurationSeconds",
        "proofOriginCoordinate",
        "proofDestinationCoordinate"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^xgt1-[0-9a-f]{24}$"},
        "fromAnchor": {"$ref": "#/$defs/anchor"},
        "toAnchor": {"$ref": "#/$defs/anchor"},
        "proposedCoordinate": {"$ref": "#/$defs/coordinate"},
        "matchEvidence": {"type": "string", "minLength": 1},
        "matchedNormalizedValue": {"type": "string", "minLength": 1},
        "provenTravelModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["MOTORCYCLE", "CAR", "BICYCLE", "WALKING"]
          }
        },
        "firstLegDistanceMeters": {"type": "number", "minimum": 0},
        "firstLegDurationSeconds": {"type": "number", "minimum": 0},
        "secondLegDistanceMeters": {"type": "number", "minimum": 0},
        "secondLegDurationSeconds": {"type": "number", "minimum": 0},
        "totalDistanceMeters": {"type": "number", "minimum": 0},
        "totalDurationSeconds": {"type": "number", "minimum": 0},
        "proofOriginCoordinate": {"$ref": "#/$defs/coordinate"},
        "proofDestinationCoordinate": {"$ref": "#/$defs/coordinate"},
        "frontierSeparationMeters": {"type": "number", "minimum": 0},
        "seamHeadingDeltaDegrees": {"type": "number", "minimum": 0, "maximum": 180}
      }
    }
  }
}
