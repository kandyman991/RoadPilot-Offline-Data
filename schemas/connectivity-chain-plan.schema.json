{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.example/schemas/connectivity-chain-plan-v1.json",
  "title": "RoadPilot multi-hop connectivity chain plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "fromRegionId",
    "toRegionId",
    "mode",
    "routeStyle",
    "maxHops",
    "status",
    "hopCount",
    "sourceArtifacts",
    "regionGraphs",
    "chains",
    "generator"
  ],
  "properties": {
    "schema": {
      "const": "roadpilot.connectivity-chain-plan"
    },
    "version": {
      "const": 1
    },
    "fromRegionId": {
      "type": "string",
      "minLength": 1
    },
    "toRegionId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "MOTORCYCLE",
        "CAR"
      ]
    },
    "maxHops": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "FOUND",
        "NO_CHAIN"
      ]
    },
    "hopCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "sourceArtifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceArtifact"
      }
    },
    "regionGraphs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph"
      }
    },
    "chains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chain"
      }
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "routeStyle": {
      "enum": [
        "FASTER",
        "SHORTER"
      ]
    }
  },
  "$defs": {
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "packageVersion",
        "graphFingerprint",
        "primaryGeofabrikId"
      ],
      "properties": {
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "graphFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primaryGeofabrikId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "graphId",
        "wayId",
        "percentAlong"
      ],
      "properties": {
        "coordinate": {
          "$ref": "#/$defs/coordinate"
        },
        "graphId": {
          "type": "integer",
          "minimum": 1
        },
        "wayId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "percentAlong": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "road": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ref",
        "highway"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "highway": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairId",
        "sha256",
        "fromRegionId",
        "toRegionId",
        "fromBoundaryFingerprint",
        "toBoundaryFingerprint"
      ],
      "properties": {
        "pairId": {
          "type": "string",
          "minLength": 3
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fromRegionId": {
          "type": "string",
          "minLength": 1
        },
        "toRegionId": {
          "type": "string",
          "minLength": 1
        },
        "fromBoundaryFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "toBoundaryFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "crossingOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "frontierRoadId",
        "stableWayId",
        "evidenceTier",
        "sourceCandidateRank",
        "road",
        "fromAnchor",
        "toAnchor",
        "rank",
        "distanceKm",
        "timeSeconds"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^xpc1-[0-9a-f]{24}$"
        },
        "frontierRoadId": {
          "type": "string",
          "pattern": "^fri1-[0-9a-f]{24}$"
        },
        "stableWayId": {
          "type": "integer",
          "minimum": 1
        },
        "evidenceTier": {
          "type": "integer",
          "minimum": 0
        },
        "sourceCandidateRank": {
          "type": "integer",
          "minimum": 0
        },
        "road": {
          "$ref": "#/$defs/road"
        },
        "fromAnchor": {
          "$ref": "#/$defs/anchor"
        },
        "toAnchor": {
          "$ref": "#/$defs/anchor"
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "distanceKm": {
          "type": "number",
          "minimum": 0
        },
        "timeSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "hop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromRegionId",
        "toRegionId",
        "sourcePairId",
        "sourceDirection",
        "fromGraph",
        "toGraph",
        "fromBoundaryFingerprint",
        "toBoundaryFingerprint",
        "crossingOptions"
      ],
      "properties": {
        "fromRegionId": {
          "type": "string",
          "minLength": 1
        },
        "toRegionId": {
          "type": "string",
          "minLength": 1
        },
        "sourcePairId": {
          "type": "string",
          "minLength": 3
        },
        "sourceDirection": {
          "enum": [
            "FROM_TO",
            "TO_FROM"
          ]
        },
        "fromGraph": {
          "$ref": "#/$defs/graph"
        },
        "toGraph": {
          "$ref": "#/$defs/graph"
        },
        "fromBoundaryFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "toBoundaryFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "crossingOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/crossingOption"
          }
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "regions",
        "hops",
        "rank",
        "score",
        "scoreUnit",
        "estimatedDistanceKm",
        "estimatedTimeSeconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^xch1-[0-9a-f]{24}$"
        },
        "regions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hop"
          }
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "scoreUnit": {
          "enum": [
            "SECONDS",
            "KILOMETERS"
          ]
        },
        "estimatedDistanceKm": {
          "type": "number",
          "minimum": 0
        },
        "estimatedTimeSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
