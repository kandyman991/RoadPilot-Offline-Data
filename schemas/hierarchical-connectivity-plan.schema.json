{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.example/schemas/hierarchical-connectivity-plan-v1.json",
  "title": "RoadPilot matrix-backed hierarchical connectivity plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "fromRegionId",
    "toRegionId",
    "mode",
    "routeStyle",
    "maxHops",
    "maxCandidates",
    "scoreScope",
    "status",
    "missingMatrixRegions",
    "sourceConnectivity",
    "sourceInventories",
    "sourceMatrices",
    "chains",
    "generator"
  ],
  "properties": {
    "schema": {
      "const": "roadpilot.hierarchical-connectivity-plan"
    },
    "version": {
      "const": 1
    },
    "fromRegionId": {
      "type": "string",
      "minLength": 1
    },
    "toRegionId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "MOTORCYCLE",
        "CAR"
      ]
    },
    "routeStyle": {
      "enum": [
        "FASTER",
        "SHORTER"
      ]
    },
    "maxHops": {
      "type": "integer",
      "minimum": 1
    },
    "maxCandidates": {
      "type": "integer",
      "minimum": 1
    },
    "scoreScope": {
      "const": "INTERMEDIATE_REGIONS_ONLY"
    },
    "status": {
      "enum": [
        "FOUND",
        "NO_CHAIN"
      ]
    },
    "missingMatrixRegions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceConnectivity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceConnectivity"
      }
    },
    "sourceInventories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceInventory"
      }
    },
    "sourceMatrices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceMatrix"
      }
    },
    "chains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chain"
      }
    },
    "generator": {
      "$ref": "#/$defs/generator"
    }
  },
  "$defs": {
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "packageVersion",
        "graphFingerprint",
        "primaryGeofabrikId"
      ],
      "properties": {
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "graphFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primaryGeofabrikId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceConnectivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairId",
        "sha256"
      ],
      "properties": {
        "pairId": {
          "type": "string",
          "minLength": 3
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "sha256",
        "graph"
      ],
      "properties": {
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "graph": {
          "$ref": "#/$defs/graph"
        }
      }
    },
    "sourceMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "sha256",
        "sourceInventorySha256",
        "graph"
      ],
      "properties": {
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceInventorySha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "graph": {
          "$ref": "#/$defs/graph"
        }
      }
    },
    "crossing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "sourcePairId",
        "fromRegionId",
        "toRegionId",
        "fromExitAnchorId",
        "toEntryAnchorId",
        "stableWayId",
        "evidenceTier",
        "sourceCandidateRank"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^xpc1-[0-9a-f]{24}$"
        },
        "sourcePairId": {
          "type": "string",
          "minLength": 3
        },
        "fromRegionId": {
          "type": "string",
          "minLength": 1
        },
        "toRegionId": {
          "type": "string",
          "minLength": 1
        },
        "fromExitAnchorId": {
          "type": "string",
          "pattern": "^rca1-[0-9a-f]{24}$"
        },
        "toEntryAnchorId": {
          "type": "string",
          "pattern": "^rca1-[0-9a-f]{24}$"
        },
        "stableWayId": {
          "type": "integer",
          "minimum": 1
        },
        "evidenceTier": {
          "type": "integer",
          "minimum": 0
        },
        "sourceCandidateRank": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "traversal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "fromEntryAnchorId",
        "toExitAnchorId",
        "distanceKm",
        "timeSeconds"
      ],
      "properties": {
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "fromEntryAnchorId": {
          "type": "string",
          "pattern": "^rca1-[0-9a-f]{24}$"
        },
        "toExitAnchorId": {
          "type": "string",
          "pattern": "^rca1-[0-9a-f]{24}$"
        },
        "distanceKm": {
          "type": "number",
          "minimum": 0
        },
        "timeSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rank",
        "regions",
        "hopCount",
        "crossings",
        "internalTraversals",
        "score",
        "scoreUnit",
        "estimatedIntermediateDistanceKm",
        "estimatedIntermediateTimeSeconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^xhc1-[0-9a-f]{24}$"
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "regions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hopCount": {
          "type": "integer",
          "minimum": 1
        },
        "crossings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/crossing"
          }
        },
        "internalTraversals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traversal"
          }
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "scoreUnit": {
          "enum": [
            "SECONDS",
            "KILOMETERS"
          ]
        },
        "estimatedIntermediateDistanceKm": {
          "type": "number",
          "minimum": 0
        },
        "estimatedIntermediateTimeSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
