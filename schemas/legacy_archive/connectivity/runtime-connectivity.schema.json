{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.example/schemas/runtime-connectivity-v1.json",
  "title": "RoadPilot validated runtime connectivity metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "pairId",
    "fromRegionId",
    "toRegionId",
    "fromBoundaryFingerprint",
    "toBoundaryFingerprint",
    "fromGraph",
    "toGraph",
    "validationState",
    "sourceHashes",
    "sourceCandidateCount",
    "sourceProofCount",
    "validatedCrossingCount",
    "supportedModeDirectionCount",
    "generator",
    "crossings"
  ],
  "properties": {
    "schema": {
      "const": "roadpilot.runtime-connectivity"
    },
    "version": {
      "const": 1
    },
    "pairId": {
      "type": "string",
      "minLength": 3
    },
    "fromRegionId": {
      "type": "string",
      "minLength": 1
    },
    "toRegionId": {
      "type": "string",
      "minLength": 1
    },
    "fromBoundaryFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "toBoundaryFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fromGraph": {
      "$ref": "#/$defs/graph"
    },
    "toGraph": {
      "$ref": "#/$defs/graph"
    },
    "validationState": {
      "const": "VALIDATED"
    },
    "sourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidatesSha256",
        "proofsSha256"
      ],
      "properties": {
        "candidatesSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "proofsSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "sourceCandidateCount": {
      "type": "integer",
      "minimum": 0
    },
    "sourceProofCount": {
      "type": "integer",
      "minimum": 0
    },
    "validatedCrossingCount": {
      "type": "integer",
      "minimum": 0
    },
    "supportedModeDirectionCount": {
      "type": "integer",
      "minimum": 0
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "crossings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossing"
      }
    }
  },
  "$defs": {
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "packageVersion",
        "graphFingerprint",
        "primaryGeofabrikId"
      ],
      "properties": {
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "graphFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primaryGeofabrikId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "graphId",
        "wayId",
        "percentAlong"
      ],
      "properties": {
        "coordinate": {
          "$ref": "#/$defs/coordinate"
        },
        "graphId": {
          "type": "integer",
          "minimum": 1
        },
        "wayId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "percentAlong": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "modeSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromTo",
        "toFrom"
      ],
      "properties": {
        "fromTo": {
          "type": "boolean"
        },
        "toFrom": {
          "type": "boolean"
        }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MOTORCYCLE",
        "CAR"
      ],
      "properties": {
        "MOTORCYCLE": {
          "$ref": "#/$defs/modeSupport"
        },
        "CAR": {
          "$ref": "#/$defs/modeSupport"
        }
      }
    },
    "road": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ref",
        "highway"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "highway": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "crossing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "frontierRoadId",
        "stableWayId",
        "sourceCandidateRank",
        "evidenceTier",
        "frontierHeadingDegrees",
        "road",
        "fromAnchor",
        "toAnchor",
        "modes",
        "routeMetrics"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^xpc1-[0-9a-f]{24}$"
        },
        "frontierRoadId": {
          "type": "string",
          "pattern": "^fri1-[0-9a-f]{24}$"
        },
        "stableWayId": {
          "type": "integer",
          "minimum": 1
        },
        "sourceCandidateRank": {
          "type": "integer",
          "minimum": 0
        },
        "evidenceTier": {
          "type": "integer",
          "minimum": 0
        },
        "frontierHeadingDegrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "road": {
          "$ref": "#/$defs/road"
        },
        "fromAnchor": {
          "$ref": "#/$defs/anchor"
        },
        "toAnchor": {
          "$ref": "#/$defs/anchor"
        },
        "modes": {
          "$ref": "#/$defs/modes"
        },
        "routeMetrics": {
          "$ref": "#/$defs/routeMetrics"
        }
      }
    },
    "routeMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distanceKm",
        "timeSeconds"
      ],
      "properties": {
        "distanceKm": {
          "type": "number",
          "minimum": 0
        },
        "timeSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "modeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromTo",
        "toFrom"
      ],
      "properties": {
        "fromTo": {
          "anyOf": [
            {
              "$ref": "#/$defs/routeMetric"
            },
            {
              "type": "null"
            }
          ]
        },
        "toFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/routeMetric"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "routeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MOTORCYCLE",
        "CAR"
      ],
      "properties": {
        "MOTORCYCLE": {
          "$ref": "#/$defs/modeMetrics"
        },
        "CAR": {
          "$ref": "#/$defs/modeMetrics"
        }
      }
    }
  }
}
