{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.app/schemas/search-pack-manifest-v1.json",
  "title": "RoadPilot regional search pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "artifactKind",
    "regionId",
    "regionName",
    "packVersion",
    "builtAtUtc",
    "databaseSchema",
    "fileName",
    "downloadUrl",
    "sha256",
    "searchFingerprint",
    "sizeBytes",
    "recordCount",
    "coverage",
    "sourceFingerprint",
    "source",
    "validation"
  ],
  "properties": {
    "schema": {
      "const": "roadpilot-search-pack"
    },
    "schemaVersion": {
      "const": 1
    },
    "artifactKind": {
      "const": "SEARCH"
    },
    "regionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "regionName": {
      "type": "string",
      "minLength": 1
    },
    "packVersion": {
      "type": "string",
      "minLength": 1
    },
    "builtAtUtc": {
      "type": "string",
      "minLength": 1
    },
    "databaseSchema": {
      "const": "roadpilot-overture-v1"
    },
    "fileName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.sqlite$"
    },
    "downloadUrl": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "searchFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "recordCount": {
      "type": "integer",
      "minimum": 1
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "enrichment": {
      "$ref": "#/$defs/enrichment"
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minLat",
        "maxLat",
        "minLng",
        "maxLng"
      ],
      "properties": {
        "minLat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "maxLat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "minLng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "maxLng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "dataRelease",
        "client",
        "clientVersion",
        "inputSha256"
      ],
      "properties": {
        "provider": {
          "const": "Overture Maps Foundation Places"
        },
        "dataRelease": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "const": "overturemaps"
        },
        "clientVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "runtimeContract",
        "targetCount",
        "results"
      ],
      "properties": {
        "passed": {
          "const": true
        },
        "runtimeContract": {
          "const": "android-overture-place-search-v1"
        },
        "targetCount": {
          "type": "integer",
          "minimum": 1
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nameEquals",
        "query",
        "passed",
        "matchedRank",
        "matchedName",
        "matchedAddress",
        "score"
      ],
      "properties": {
        "nameEquals": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 2
        },
        "passed": {
          "const": true
        },
        "matchedRank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "matchedName": {
          "type": "string",
          "minLength": 1
        },
        "matchedAddress": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeContracts",
        "categorySearch",
        "proximityRanking",
        "structuredAddress",
        "sourceIdentity"
      ],
      "properties": {
        "runtimeContracts": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "const": "roadpilot-search-v2"
          }
        },
        "categorySearch": {
          "const": true
        },
        "proximityRanking": {
          "const": true
        },
        "structuredAddress": {
          "const": true
        },
        "sourceIdentity": {
          "const": true
        }
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "categorizedRecordCount",
        "structuredAddressRecordCount",
        "sourceIdentifiedRecordCount"
      ],
      "properties": {
        "schema": {
          "const": "roadpilot-search-enrichment-v2"
        },
        "categorizedRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "structuredAddressRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourceIdentifiedRecordCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
