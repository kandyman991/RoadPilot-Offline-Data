{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.example/schemas/crossing-candidates-v1.json",
  "title": "RoadPilot unproven cross-region crossing candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "pairId",
    "fromRegionId",
    "toRegionId",
    "fromBoundaryFingerprint",
    "toBoundaryFingerprint",
    "fromGraph",
    "toGraph",
    "generator",
    "frontierRoadCount",
    "candidateCount",
    "unresolvedFrontierRoadIds",
    "candidates"
  ],
  "properties": {
    "schema": {
      "const": "roadpilot.crossing-candidates"
    },
    "version": {
      "const": 1
    },
    "pairId": {
      "type": "string",
      "minLength": 3
    },
    "fromRegionId": {
      "type": "string",
      "minLength": 1
    },
    "toRegionId": {
      "type": "string",
      "minLength": 1
    },
    "fromBoundaryFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "toBoundaryFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fromGraph": {
      "$ref": "#/$defs/graph"
    },
    "toGraph": {
      "$ref": "#/$defs/graph"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "frontierRoadCount": {
      "type": "integer",
      "minimum": 0
    },
    "candidateCount": {
      "type": "integer",
      "minimum": 0
    },
    "unresolvedFrontierRoadIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^fri1-[0-9a-f]{24}$"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "packageVersion",
        "graphFingerprint",
        "primaryGeofabrikId"
      ],
      "properties": {
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "graphFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primaryGeofabrikId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlationRank",
        "wayMatch",
        "correlatedCoordinate",
        "wayId",
        "percentAlong",
        "distanceMeters",
        "headingDegrees",
        "linearReference",
        "graphId",
        "roadNames",
        "access",
        "roadClass",
        "use"
      ],
      "properties": {
        "correlationRank": {
          "type": "integer",
          "minimum": 0
        },
        "wayMatch": {
          "type": "boolean"
        },
        "correlatedCoordinate": {
          "$ref": "#/$defs/coordinate"
        },
        "wayId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "percentAlong": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "distanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "headingDegrees": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "linearReference": {
          "type": [
            "string",
            "null"
          ]
        },
        "graphId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "roadNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "roadClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "use": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "bothMatchStableWay",
        "sameCorrelatedWay",
        "oneMatchesStableWay",
        "sharedRoadNames",
        "separationMeters",
        "combinedCorrelationDistanceMeters",
        "headingDeltaDegrees"
      ],
      "properties": {
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "bothMatchStableWay": {
          "type": "boolean"
        },
        "sameCorrelatedWay": {
          "type": "boolean"
        },
        "oneMatchesStableWay": {
          "type": "boolean"
        },
        "sharedRoadNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "separationMeters": {
          "type": "number",
          "minimum": 0
        },
        "combinedCorrelationDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "headingDeltaDegrees": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 180
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidateRank",
        "frontierRoadId",
        "stableWayId",
        "crossingIndex",
        "crossingKind",
        "frontierCoordinate",
        "frontierHeadingDegrees",
        "routingTags",
        "fromEdge",
        "toEdge",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^xpc1-[0-9a-f]{24}$"
        },
        "candidateRank": {
          "type": "integer",
          "minimum": 0
        },
        "frontierRoadId": {
          "type": "string",
          "pattern": "^fri1-[0-9a-f]{24}$"
        },
        "stableWayId": {
          "type": "integer",
          "minimum": 1
        },
        "crossingIndex": {
          "type": "integer",
          "minimum": 0
        },
        "crossingKind": {
          "enum": [
            "CROSSING",
            "FRONTIER_OVERLAP"
          ]
        },
        "frontierCoordinate": {
          "$ref": "#/$defs/coordinate"
        },
        "frontierHeadingDegrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "routingTags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fromEdge": {
          "$ref": "#/$defs/edge"
        },
        "toEdge": {
          "$ref": "#/$defs/edge"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  }
}
