{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "f8-graph-studio-native-private-catalog.schema.json",
  "title": "Graph Studio private original-Valhalla A-final → exact X → directed B validation artifact",
  "description": "Owner-only Graph Studio native-verified status, independent from Android acceptance, not a RoadPilot runtime READY or public release catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "pairId",
    "fromRegionId",
    "toRegionId",
    "publication",
    "intendedUse",
    "notForRoadPilotRuntime",
    "originalGraphArchives",
    "independentSourcePreflightSha256",
    "nativeEvidenceSha256",
    "counts",
    "connections",
    "excludedSourceFinals",
    "graphStudioNativeCoverageScope",
    "sourcePhysicalRoadDirectionCompleteness",
    "unverifiedSourcePhysicalRoadLineages"
  ],
  "properties": {
    "schema": {
      "const": "roadpilot.f8-graph-studio-private-validated-catalog"
    },
    "version": {
      "const": 1
    },
    "pairId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,128}__[a-z0-9-]{1,128}$"
    },
    "fromRegionId": {
      "$ref": "#/$defs/region"
    },
    "toRegionId": {
      "$ref": "#/$defs/region"
    },
    "publication": {
      "const": "GRAPH_STUDIO_PRIVATE_READY"
    },
    "intendedUse": {
      "const": "OWNER_ONLY_GRAPH_STUDIO_TESTING"
    },
    "notForRoadPilotRuntime": {
      "const": true
    },
    "originalGraphArchives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/hash"
        },
        "to": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "independentSourcePreflightSha256": {
      "$ref": "#/$defs/hash"
    },
    "nativeEvidenceSha256": {
      "$ref": "#/$defs/hash"
    },
    "graphStudioNativeCoverageScope": {
      "const": "VERIFIED_WITHIN_ORIGINAL_PAIR_ENDPOINT_DOMAIN"
    },
    "sourcePhysicalRoadDirectionCompleteness": {
      "const": "NOT_VERIFIED"
    },
    "unverifiedSourcePhysicalRoadLineages": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalSourceFinals",
        "sourceConnections",
        "receiverIncomingRoads",
        "excludedOriginalSourceFinals"
      ],
      "properties": {
        "originalSourceFinals": {
          "type": "integer",
          "minimum": 1
        },
        "sourceConnections": {
          "type": "integer",
          "minimum": 1
        },
        "receiverIncomingRoads": {
          "type": "integer",
          "minimum": 1
        },
        "excludedOriginalSourceFinals": {
          "const": 0
        }
      }
    },
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "excludedSourceFinals": {
      "const": []
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "graphId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854776000
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "car",
          "motorcycle"
        ]
      }
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "x": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiverDirectedGraphId",
        "receiverXPosition",
        "travelModes",
        "nativeXGapMeters",
        "directedApproachOverlapMeters"
      ],
      "properties": {
        "receiverDirectedGraphId": {
          "$ref": "#/$defs/graphId"
        },
        "receiverXPosition": {
          "enum": [
            "END_NODE",
            "INTERIOR"
          ]
        },
        "travelModes": {
          "$ref": "#/$defs/modes"
        },
        "nativeXGapMeters": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.75
        },
        "directedApproachOverlapMeters": {
          "type": "number",
          "minimum": 0.5
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "directedApproachOverlapMeters": {
                "exclusiveMaximum": 1
              }
            },
            "required": [
              "directedApproachOverlapMeters"
            ]
          },
          "then": {
            "properties": {
              "nativeXGapMeters": {
                "maximum": 0.1
              }
            }
          }
        }
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceFinalDirectedGraphId",
        "exactX",
        "sourceModes",
        "receiverDirectedRoadsAtX"
      ],
      "properties": {
        "sourceFinalDirectedGraphId": {
          "$ref": "#/$defs/graphId"
        },
        "exactX": {
          "$ref": "#/$defs/x"
        },
        "sourceModes": {
          "$ref": "#/$defs/modes"
        },
        "receiverDirectedRoadsAtX": {
          "type": "array",
          "minItems": 1,
          "maxItems": 250,
          "items": {
            "$ref": "#/$defs/receiver"
          }
        }
      }
    }
  }
}
