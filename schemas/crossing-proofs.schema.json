{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.example/schemas/crossing-proofs-v1.json",
  "title": "RoadPilot plain-Valhalla crossing proofs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "pairId",
    "fromRegionId",
    "toRegionId",
    "fromBoundaryFingerprint",
    "toBoundaryFingerprint",
    "fromGraph",
    "toGraph",
    "generator",
    "sourceCandidateCount",
    "provenCandidateCount",
    "rejectedCandidateCount",
    "inconclusiveCandidateCount",
    "proofs"
  ],
  "properties": {
    "schema": {
      "const": "roadpilot.crossing-proofs"
    },
    "version": {
      "const": 1
    },
    "pairId": {
      "type": "string",
      "minLength": 3
    },
    "fromRegionId": {
      "type": "string",
      "minLength": 1
    },
    "toRegionId": {
      "type": "string",
      "minLength": 1
    },
    "fromBoundaryFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "toBoundaryFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fromGraph": {
      "$ref": "#/$defs/graph"
    },
    "toGraph": {
      "$ref": "#/$defs/graph"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "sourceCandidateCount": {
      "type": "integer",
      "minimum": 0
    },
    "provenCandidateCount": {
      "type": "integer",
      "minimum": 0
    },
    "rejectedCandidateCount": {
      "type": "integer",
      "minimum": 0
    },
    "inconclusiveCandidateCount": {
      "type": "integer",
      "minimum": 0
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof"
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "packageVersion",
        "graphFingerprint",
        "primaryGeofabrikId"
      ],
      "properties": {
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "graphFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primaryGeofabrikId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probeGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "fromProbe",
        "toProbe",
        "fromProbeDistanceMeters",
        "toProbeDistanceMeters"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "REGION_INTERIOR",
            "FRONTIER_LONGITUDINAL"
          ]
        },
        "fromProbe": {
          "$ref": "#/$defs/coordinate"
        },
        "toProbe": {
          "$ref": "#/$defs/coordinate"
        },
        "fromProbeDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "toProbeDistanceMeters": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "regionId",
        "start",
        "end",
        "directDistanceMeters",
        "elapsedMs",
        "routeLengthKm",
        "routeTimeSeconds"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASSED",
            "FAILED",
            "ERROR"
          ]
        },
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/coordinate"
        },
        "end": {
          "$ref": "#/$defs/coordinate"
        },
        "directDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "routeLengthKm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "routeTimeSeconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "error": {
          "type": "string"
        }
      }
    },
    "directionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "graphA",
        "graphB"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "graphA": {
          "$ref": "#/$defs/leg"
        },
        "graphB": {
          "$ref": "#/$defs/leg"
        }
      }
    },
    "modeProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromTo",
        "toFrom"
      ],
      "properties": {
        "fromTo": {
          "$ref": "#/$defs/directionProof"
        },
        "toFrom": {
          "$ref": "#/$defs/directionProof"
        }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MOTORCYCLE",
        "CAR"
      ],
      "properties": {
        "MOTORCYCLE": {
          "$ref": "#/$defs/modeProof"
        },
        "CAR": {
          "$ref": "#/$defs/modeProof"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "frontierRoadId",
        "candidateRank",
        "stableWayId",
        "proofState",
        "probeGeometry",
        "supportedDirections",
        "modes"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^xpc1-[0-9a-f]{24}$"
        },
        "frontierRoadId": {
          "type": "string",
          "pattern": "^fri1-[0-9a-f]{24}$"
        },
        "candidateRank": {
          "type": "integer",
          "minimum": 0
        },
        "stableWayId": {
          "type": "integer",
          "minimum": 1
        },
        "proofState": {
          "enum": [
            "PROVEN",
            "REJECTED",
            "INCONCLUSIVE"
          ]
        },
        "probeGeometry": {
          "$ref": "#/$defs/probeGeometry"
        },
        "supportedDirections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "MOTORCYCLE_FROM_TO",
              "MOTORCYCLE_TO_FROM",
              "CAR_FROM_TO",
              "CAR_TO_FROM"
            ]
          }
        },
        "modes": {
          "$ref": "#/$defs/modes"
        }
      }
    }
  }
}
