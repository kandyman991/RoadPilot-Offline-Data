{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.example/schemas/f8-final-directed-connection-candidates-v1.json",
  "title": "RoadPilot Graph Studio D-017 original-native A to exact X to B candidate/exception ledger (NOT PUBLISHABLE)",
  "description": "First-class original directed A-final to corresponding B road match at exact X; B outgoing-turn candidate/exception records are diagnostic only, never a matching prerequisite. NOT the legacy Android TripLeg v1 catalog; NEVER READY production.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "pairId", "fromRegionId", "toRegionId", "graphFingerprints", "sourceBufferFingerprint", "receiverBufferFingerprint", "sourceGraphIndexFingerprint", "receiverGraphIndexFingerprint", "originalSourceEvidenceSha256", "reciprocalBoundaryFingerprints", "originalSourceTileTerminalInventory", "physicalRoadIdentityAcceptance", "oneRecordPerSourceFinalDirectedGraphId", "noDistinctSourceOrReceiverBranchSuppressed", "sourceDiscoveryComplete", "receiverMatchingComplete", "androidFullJourneyAcceptance", "productionPublication", "counts", "nativeDirectedRoadMatchesAtX", "connectionCandidates", "unresolvedSourceFinalEdges", "unresolvedOriginalCutRootLineageGraphIds"],
  "properties": {
    "schema": {"const": "roadpilot.f8-final-directed-connection-candidates"},
    "version": {"const": 1},
    "pairId": {"type":"string", "minLength": 3, "maxLength": 256},
    "fromRegionId": {"type":"string", "minLength":1,"maxLength":128},
    "toRegionId": {"type":"string", "minLength":1,"maxLength":128},
    "graphFingerprints": {"type":"object", "additionalProperties":false,
       "required":["from","to"],"properties":{"from":{"$ref":"#/$defs/sha"},"to":{"$ref":"#/$defs/sha"}}},
    "sourceBufferFingerprint":{"$ref":"#/$defs/sha"},
    "receiverBufferFingerprint":{"$ref":"#/$defs/sha"},
    "sourceGraphIndexFingerprint":{"$ref":"#/$defs/sha"},
    "receiverGraphIndexFingerprint":{"$ref":"#/$defs/sha"},
    "originalSourceEvidenceSha256":{"$ref":"#/$defs/sha"},
    "reciprocalBoundaryFingerprints":{"type":"object","additionalProperties":false,"required":["from","to"],
      "properties":{"from":{"$ref":"#/$defs/sha"},"to":{"$ref":"#/$defs/sha"}}},
    "originalSourceTileTerminalInventory":{"const":"VERIFIED_FOR_ORIGINAL_B_COVERED_OUTER_ENDPOINT_DOMAIN"},
    "physicalRoadIdentityAcceptance":{"const":"NOT_VERIFIED"},
    "oneRecordPerSourceFinalDirectedGraphId":{"const":true},
    "noDistinctSourceOrReceiverBranchSuppressed":{"const":true},
    "sourceDiscoveryComplete":{"const":false},
    "receiverMatchingComplete":{"const":false},
    "androidFullJourneyAcceptance":{"const":"NOT_RUN"},
    "productionPublication":{"const":"BLOCKED"},
    "counts":{"type":"object","additionalProperties":false,
      "required":["eligibleSourceFinals","sourceFinalsWithMatchedBDirectedRoadAtX","sourceFinalsWithoutMatchedBDirectedRoadAtX","nativeBDirectedRoadMatchesAtX","candidateSourcesWithBOptions","unresolvedEligibleSourceFinals","nativeOriginalBDirectedOptions","branchAttributeEvidenceCounts","originalSourceCutRootsNotLinkedWithinBoundedScope"],
      "properties":{
        "eligibleSourceFinals":{"type":"integer","minimum":1},
        "sourceFinalsWithMatchedBDirectedRoadAtX":{"type":"integer","minimum":0},
        "sourceFinalsWithoutMatchedBDirectedRoadAtX":{"type":"integer","minimum":0},
        "nativeBDirectedRoadMatchesAtX":{"type":"integer","minimum":0},
        "candidateSourcesWithBOptions":{"type":"integer","minimum":0},
        "unresolvedEligibleSourceFinals":{"type":"integer","minimum":0},
        "nativeOriginalBDirectedOptions":{"type":"integer","minimum":0},
        "branchAttributeEvidenceCounts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
        "originalSourceCutRootsNotLinkedWithinBoundedScope":{"type":"integer","minimum":0}
      }
    },
    "nativeDirectedRoadMatchesAtX":{"type":"array","items":{"$ref":"#/$defs/roadMatch"}},
    "connectionCandidates":{"type":"array","items":{"$ref":"#/$defs/connection"}},
    "unresolvedSourceFinalEdges":{"type":"array","items":{"$ref":"#/$defs/unresolved"}},
    "unresolvedOriginalCutRootLineageGraphIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/graphid"}}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "graphid":{"type":"integer","minimum":1},
    "mode":{"enum":["auto","motorcycle"]},
    "modes":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/mode"}},
    "x":{"type":"object","additionalProperties":false,"required":["lat","lng"],
        "properties":{"lat":{"type":"number","minimum":-90,"maximum":90},"lng":{"type":"number","minimum":-180,"maximum":180}}},
    "source":{"type":"object","required":["sourceFinalDirectedGraphId","sourceFinalCoordinate","sourceValhallaProvedModes","sourceOriginalNativeEndNodeGraphId","sourceOriginalNativeRoadClass","sourceOriginalNativeRoadUse","sourceNativeLayer","sourceNativeBridge","sourceNativeTunnel","receiverCorrelationStatus","sourcePhysicalRoadIdentity"],
      "properties":{
        "sourceFinalDirectedGraphId":{"$ref":"#/$defs/graphid"},
        "sourceFinalCoordinate":{"$ref":"#/$defs/x"},
        "sourceValhallaProvedModes":{"$ref":"#/$defs/modes"},
        "sourceOriginalNativeEndNodeGraphId":{"type":"integer","minimum":0},
        "sourceOriginalNativeRoadClass":{"type":"integer","minimum":0},
        "sourceOriginalNativeRoadUse":{"type":"integer","minimum":0},
        "sourceNativeLayer":{"type":"integer"},
        "sourceNativeBridge":{"type":"boolean"},
        "sourceNativeTunnel":{"type":"boolean"},
        "receiverCorrelationStatus":{"type":"string","minLength":3},
        "sourcePhysicalRoadIdentity":{"const":"NOT_VERIFIED"}
      }
    },
    "roadMatch":{"type":"object","additionalProperties":false,
      "required":["sourceFinalDirectedGraphId","sourceFinalCoordinate","sourceValhallaProvedModes","receiverDirectedRoadsAtX","status","productionRouteVerified"],
      "properties":{
        "sourceFinalDirectedGraphId":{"$ref":"#/$defs/graphid"},
        "sourceFinalCoordinate":{"$ref":"#/$defs/x"},
        "sourceValhallaProvedModes":{"$ref":"#/$defs/modes"},
        "receiverDirectedRoadsAtX":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/matchedB"}},
        "status":{"enum":["NATIVE_DIRECTED_ROAD_MATCH_AT_X","NO_VERIFIED_DIRECTED_RECEIVER_ROAD_AT_X"]},
        "productionRouteVerified":{"const":false}
      }},
    "matchedB":{"type":"object","additionalProperties":false,
      "required":["receiverDirectedGraphId","nativeGeometryRelationship","receiverXPosition","nativeCommonVehicleModes","distanceXMetres","directedApproachOverlapMetres","receiverNativeRoadClass","receiverNativeRoadUse","receiverNativeLayer","receiverNativeBridge","receiverNativeTunnel","productionRouteVerified"],
      "properties":{
        "receiverDirectedGraphId":{"$ref":"#/$defs/graphid"},
        "nativeGeometryRelationship":{"enum":["B_PREDECESSOR_ENDS_AT_X_NEEDS_NATIVE_SUCCESSOR","MATCHED_DIRECTED_SOURCE_GEOMETRY_OVERLAP"]},
        "receiverXPosition":{"enum":["END_NODE","INTERIOR"]},
        "nativeCommonVehicleModes":{"type":"integer","enum":[1,1024,1025]},
        "distanceXMetres":{"type":"number","minimum":0,"maximum":0.75},
        "directedApproachOverlapMetres":{"type":"number","minimum":0.5},
        "receiverNativeRoadClass":{"type":"integer","minimum":0},
        "receiverNativeRoadUse":{"type":"integer","minimum":0},
        "receiverNativeLayer":{"type":"integer"},
        "receiverNativeBridge":{"type":"boolean"},
        "receiverNativeTunnel":{"type":"boolean"},
        "productionRouteVerified":{"const":false}
      }},
    "connection":{"allOf":[{"$ref":"#/$defs/source"},
      {"type":"object","required":["nativeBOriginalPredecessorGraphIds","receiverOptions","unresolvedOriginalNativeBTransitions","status"],
       "properties":{
         "nativeBOriginalPredecessorGraphIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/graphid"}},
         "receiverOptions":{"type":"array","minItems":1,"maxItems":250,"items":{"$ref":"#/$defs/receiverOption"}},
         "unresolvedOriginalNativeBTransitions":{"type":"array","items":{"type":"object"}},
         "status":{"const":"NATIVE_CANDIDATE_NOT_PUBLISHED"}
       }}]},
    "unresolved":{"allOf":[{"$ref":"#/$defs/source"},
      {"type":"object","required":["reason","mustNotCreateConnection","nativeBOriginalPredecessorGraphIds","unresolvedOriginalNativeBTransitions"],
        "properties":{
          "reason":{"enum":["ORIGINAL_B_CONDITIONAL_HIERARCHY_OR_PATH_CONTEXT_UNRESOLVED","NO_ORIGINAL_B_NATIVE_ALLOWED_FORWARD_CONTINUATION"]},
          "mustNotCreateConnection":{"const":true},
          "nativeBOriginalPredecessorGraphIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/graphid"}},
          "unresolvedOriginalNativeBTransitions":{"type":"array","items":{"type":"object"}}
        }}]},
    "receiverOption":{"type":"object","additionalProperties":false,
       "required":["receiverFirstDirectedGraphId","receiverGraphFingerprint","travelModes","nativeOriginalBPredecessorDirectedGraphIds","nativeCorrespondenceEvidence","nativePhysicalBranchEvidence","samePhysicalRoadVerified","androidJourneyVerified"],
       "properties":{
         "receiverFirstDirectedGraphId":{"$ref":"#/$defs/graphid"},
         "receiverGraphFingerprint":{"$ref":"#/$defs/sha"},
         "travelModes":{"$ref":"#/$defs/modes"},
         "nativeOriginalBPredecessorDirectedGraphIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/graphid"}},
         "nativeCorrespondenceEvidence":{"enum":["VERIFIED_B_ORIGINAL_SAME_NODE_LEGAL_BRANCH","VERIFIED_B_DIRECTED_INTERIOR_SOURCE_OVERLAP"]},
         "nativePhysicalBranchEvidence":{"enum":["NATIVE_STRUCTURE_CHANGE_PHYSICAL_IDENTITY_UNVERIFIED","NATIVE_CLASS_OR_USE_CHANGE_PHYSICAL_IDENTITY_UNVERIFIED","CONSISTENT_NATIVE_ROAD_ATTRIBUTES_PHYSICAL_IDENTITY_UNVERIFIED","INTERIOR_B_EDGE_OVERLAP_PHYSICAL_IDENTITY_UNVERIFIED"]},
         "samePhysicalRoadVerified":{"const":false},
         "androidJourneyVerified":{"const":false},
         "receiverNativeRoadClass":{"type":"integer","minimum":0},
         "receiverNativeRoadUse":{"type":"integer","minimum":0},
         "receiverNativeLayer":{"type":"integer"},
         "receiverNativeBridge":{"type":"boolean"},
         "receiverNativeTunnel":{"type":"boolean"},
         "nativeReceiverStartGapMetres":{"type":"number","minimum":0,"maximum":0.75},
         "nativeSameClassAsBPredecessor":{"type":"boolean"},
         "nativeSameUseAsBPredecessor":{"type":"boolean"},
         "nativeSameStructureAsBPredecessor":{"type":"boolean"}
       }
    }
  }
}
