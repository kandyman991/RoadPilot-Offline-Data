{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpilot.example/schemas/bound-cross-graph-transitions-v1.json",
  "title": "RoadPilot bound cross-graph transition artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "fromRegionId",
    "toRegionId",
    "fromGraphFingerprint",
    "toGraphFingerprint",
    "bindingMode",
    "generator",
    "transitions"
  ],
  "properties": {
    "schema": {"const": "roadpilot.bound-cross-graph-transitions"},
    "version": {"const": 1},
    "fromRegionId": {"type": "string", "minLength": 1},
    "toRegionId": {"type": "string", "minLength": 1},
    "fromGraphFingerprint": {"type": "string", "minLength": 1},
    "toGraphFingerprint": {"type": "string", "minLength": 1},
    "bindingMode": {
      "enum": ["MOTORCYCLE", "CAR", "BICYCLE", "WALKING"]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/transition"}
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lng": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlationRank",
        "graphId",
        "opposingGraphId",
        "sourceNodeGraphId",
        "endNodeGraphId",
        "wayId",
        "correlatedCoordinate",
        "percentAlong",
        "distanceMeters",
        "headingDegrees",
        "inboundReach",
        "outboundReach",
        "forwardAccess",
        "reverseAccess",
        "roadClass",
        "use",
        "roadNames",
        "roadRefs"
      ],
      "properties": {
        "correlationRank": {"type": "integer", "minimum": 0},
        "graphId": {"type": "integer", "minimum": 1},
        "opposingGraphId": {"type": "integer", "minimum": 1},
        "sourceNodeGraphId": {"type": "integer", "minimum": 1},
        "endNodeGraphId": {"type": "integer", "minimum": 1},
        "wayId": {"type": "integer", "minimum": 1},
        "correlatedCoordinate": {"$ref": "#/$defs/coordinate"},
        "percentAlong": {"type": "number", "minimum": 0, "maximum": 1},
        "distanceMeters": {"type": "number", "minimum": 0},
        "headingDegrees": {"type": "number", "minimum": 0, "maximum": 360},
        "inboundReach": {"type": "integer", "minimum": 0},
        "outboundReach": {"type": "integer", "minimum": 0},
        "forwardAccess": {"type": "integer", "minimum": 0},
        "reverseAccess": {"type": "integer", "minimum": 0},
        "roadClass": {"type": "integer", "minimum": 0},
        "use": {"type": "integer", "minimum": 0},
        "roadNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "roadRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "graphFingerprint",
        "proofCoordinate",
        "candidates"
      ],
      "properties": {
        "regionId": {"type": "string", "minLength": 1},
        "graphFingerprint": {"type": "string", "minLength": 1},
        "proofCoordinate": {"$ref": "#/$defs/coordinate"},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/edge"}
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceProofId",
        "fromBinding",
        "toBinding"
      ],
      "properties": {
        "sourceProofId": {"type": "string", "pattern": "^xgt1-[0-9a-f]{24}$"},
        "fromBinding": {"$ref": "#/$defs/binding"},
        "toBinding": {"$ref": "#/$defs/binding"}
      }
    }
  }
}
