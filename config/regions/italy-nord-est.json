{
  "schemaVersion": 1,
  "id": "italy-nord-est",
  "name": "Italy Nord-Est / Dolomites",
  "overture": {
    "enabled": true,
    "country": "IT",
    "databaseSchema": "roadpilot-overture-v1",
    "fileName": "italy-nord-est-v1.sqlite",
    "manifestFileName": "italy-nord-est-v1.json",
    "coverage": {
      "minLat": 44.5,
      "maxLat": 46.8,
      "minLng": 10.4,
      "maxLng": 13.4
    },
    "validation": [
      {
        "nameEquals": "SARP",
        "addressContainsAny": [
          "montebelluna",
          "san martino di lupari",
          "colombara"
        ]
      }
    ]
  },
  "routing": {
    "enabled": true,
    "borderBufferKm": 25,
    "buildConcurrency": 12,
    "source": {
      "primaryGeofabrikId": "italy/nord-est",
      "polygonUrl": "https://download.geofabrik.de/europe/italy/nord-est.poly",
      "pbfs": [
        {
          "id": "italy/nord-est",
          "url": "https://download.geofabrik.de/europe/italy/nord-est-latest.osm.pbf"
        },
        {
          "id": "italy/nord-ovest",
          "url": "https://download.geofabrik.de/europe/italy/nord-ovest-latest.osm.pbf"
        },
        {
          "id": "italy/centro",
          "url": "https://download.geofabrik.de/europe/italy/centro-latest.osm.pbf"
        },
        {
          "id": "austria",
          "url": "https://download.geofabrik.de/europe/austria-latest.osm.pbf"
        },
        {
          "id": "switzerland",
          "url": "https://download.geofabrik.de/europe/switzerland-latest.osm.pbf"
        },
        {
          "id": "slovenia",
          "url": "https://download.geofabrik.de/europe/slovenia-latest.osm.pbf"
        }
      ]
    },
    "package": {
      "fileNameTemplate": "italy-nord-est-routing-{version}.tar",
      "manifestFileNameTemplate": "italy-nord-est-routing-{version}-manifest.json"
    },
    "validationRoutes": [
      {
        "name": "dolomites-interior",
        "kind": "interior",
        "costing": "motorcycle",
        "start": {
          "lat": 46.0748,
          "lng": 11.1217
        },
        "end": {
          "lat": 46.5405,
          "lng": 12.1357
        }
      },
      {
        "name": "coccau-austria-border",
        "kind": "border",
        "costing": "motorcycle",
        "start": {
          "lat": 46.501885,
          "lng": 13.592668
        },
        "end": {
          "lat": 46.592234,
          "lng": 13.846448
        }
      }
    ],
    "expectedValhallaVersion": "3.6.3"
  },
  "visual": {
    "enabled": true,
    "source": {
      "primaryGeofabrikId": "italy/nord-est",
      "url": "https://download.geofabrik.de/europe/italy/nord-est-latest.osm.pbf",
      "polygonUrl": "https://download.geofabrik.de/europe/italy/nord-est.poly"
    },
    "buildThreads": 4,
    "package": {
      "fileNameTemplate": "italy-nord-est-visual-{version}.pmtiles",
      "manifestFileNameTemplate": "italy-nord-est-visual-{version}-manifest.json",
      "roadIndexFileNameTemplate": "italy-nord-est-visual-{version}-road-index.json"
    },
    "validation": {
      "majorRoadClasses": [
        "motorway",
        "trunk",
        "primary",
        "secondary"
      ],
      "borderToleranceMeters": 75
    }
  }
}
